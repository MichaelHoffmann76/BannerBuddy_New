<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BannerBuddy.AddIn</AssemblyName>
    <RootNamespace>BannerBuddy.AddIn</RootNamespace>
        <ComVisible>true</ComVisible>
        <!-- RegisterForComInterop only when using Full MSBuild (Visual Studio),
          avoids MSB4803 when building with `dotnet build` which uses Core MSBuild -->
        <RegisterForComInterop Condition="'$(MSBuildRuntimeType)' == 'Full'">true</RegisterForComInterop>
        <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.4797.1004" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <Reference Include="office">
      <HintPath>C:\Windows\assembly\GAC_MSIL\office\15.0.0.0__71e9bce111e9429c\office.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="stdole">
      <HintPath>C:\Windows\assembly\GAC\stdole\7.0.3300.0__b03f5f7f11d50a3a\stdole.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Extensibility">
      <HintPath>C:\Program Files (x86)\Common Files\Microsoft Shared\MSEnv\PublicAssemblies\extensibility.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AddIn\Ribbon.xml" />
    <EmbeddedResource Include="AddIn\Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Update="UI\BannerWindow.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
    <Compile Update="UI\BannerWindow.xaml.cs">
      <DependentUpon>BannerWindow.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
</Project>
