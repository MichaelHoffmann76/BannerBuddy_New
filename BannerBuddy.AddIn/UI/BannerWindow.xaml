<Window x:Class="BannerBuddy.AddIn.UI.BannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BannerBuddy"
    Height="640"
    Width="720"
    MinHeight="520"
    MinWidth="640"
    ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Banner &amp; Urlaubsverwaltung"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">

            <!-- Drag & Drop Zone -->
            <Border x:Name="DropZone"
                    Height="120"
                    BorderBrush="Gray"
                    BorderThickness="2"
                    CornerRadius="6"
                    Background="#FFF5F5F5"
                    AllowDrop="True"
                    Margin="0,0,0,10"
                    Drop="DropZone_OnDrop"
                    DragOver="DropZone_OnDragOver">

                <TextBlock Text="Banner hier per Drag &amp; Drop ablegen (GIF / PNG / JPG)"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="Gray"/>
            </Border>

            <!-- Banner Preview -->
            <Image x:Name="BannerPreview"
                   Height="120"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   Margin="0,0,0,10"/>

            <GroupBox Header="Banner-Zeitraum" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="BannerEnabled"
                              Content="Banner aktiv"
                              IsChecked="True"
                              Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Von:" Width="40" VerticalAlignment="Center"/>
                        <DatePicker x:Name="StartDate" Width="120"/>
                        <TextBlock Text="Bis:" Width="40" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <DatePicker x:Name="EndDate" Width="120"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Header="Urlaubs-Hinweis (Vorab)" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox x:Name="VacationEnabled"
                              Content="Urlaubs-Hinweis aktiv"
                              IsChecked="False"
                              Margin="0,0,0,8"/>

                    <TextBox x:Name="VacationText"
                             Grid.Row="1"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             ToolTip="Optionaler Zusatztext (der Zeitraum wird automatisch eingefügt).\nBeispiel: Ich antworte ggf. zeitverzögert."
                             Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBlock Text="Von:" Width="40" VerticalAlignment="Center"/>
                        <DatePicker x:Name="VacationStartDate" Width="120"/>
                        <TextBlock Text="Bis:" Width="40" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <DatePicker x:Name="VacationEndDate" Width="120"/>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Hinweis" Width="55" VerticalAlignment="Center"/>
                        <TextBox x:Name="VacationNoticeDays"
                                 Width="50"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Wie viele Tage vor Urlaubsbeginn soll der Hinweis in der Signatur erscheinen? (1–365)"/>
                        <TextBlock Text="Tage vorher" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

                 <!-- Auswahl gespeicherter Banner -->
                 <ComboBox x:Name="BannerSelect"
                     Height="28"
                     Margin="0,0,0,10"
                     SelectionChanged="BannerSelect_OnSelectionChanged"/>

            <!-- Info -->
            <TextBlock x:Name="BannerInfo"
                       FontSize="12"
                       Foreground="Gray"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern"
                Width="120"
                Margin="5"
                Click="Save_Click"/>
            <Button Content="Schließen"
                    Width="100"
                    Margin="5"
                    Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
