<Window x:Class="BannerBuddy.AddIn.UI.BannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BannerBuddy"
    Height="640"
    Width="720"
    MinHeight="520"
    MinWidth="640"
    ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="BannerBuddy – Signaturverwaltung"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Content: Tab-Struktur (Banner / Urlaub / Signatur) -->
        <TabControl Grid.Row="1">

            <!-- TAB 1: Banner -->
            <TabItem Header="Banner">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">

                        <!-- Drag & Drop Zone -->
                        <Border x:Name="DropZone"
                                Height="120"
                                BorderBrush="Gray"
                                BorderThickness="2"
                                CornerRadius="6"
                                Background="#FFF5F5F5"
                                AllowDrop="True"
                                Margin="0,0,0,10"
                                Drop="DropZone_OnDrop"
                                DragOver="DropZone_OnDragOver">

                            <TextBlock Text="Banner hier per Drag &amp; Drop ablegen (GIF / PNG / JPG)"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="Gray"/>
                        </Border>

                        <!-- Banner Preview -->
                        <Image x:Name="BannerPreview"
                               Height="120"
                               Stretch="Uniform"
                               Visibility="Collapsed"
                               Margin="0,0,0,10"/>

                        <GroupBox Header="Banner-Zeitraum" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="BannerEnabled"
                                          Content="Banner aktiv"
                                          IsChecked="True"
                                          Margin="0,0,0,8"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Von:" Width="40" VerticalAlignment="Center"/>
                                    <DatePicker x:Name="StartDate" Width="120"/>
                                    <TextBlock Text="Bis:" Width="40" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <DatePicker x:Name="EndDate" Width="120"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Auswahl gespeicherter Banner -->
                        <ComboBox x:Name="BannerSelect"
                                  Height="28"
                                  Margin="0,0,0,10"
                                  SelectionChanged="BannerSelect_OnSelectionChanged"/>

                        <!-- Info -->
                        <TextBlock x:Name="BannerInfo"
                                   FontSize="12"
                                   Foreground="Gray"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Urlaub -->
            <TabItem Header="Urlaub">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">

                        <GroupBox Header="Urlaubs-Hinweis (Vorab)" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox x:Name="VacationEnabled"
                                          Content="Urlaubs-Hinweis aktiv"
                                          IsChecked="False"
                                          Margin="0,0,0,8"/>

                                <TextBox x:Name="VacationText"
                                         Grid.Row="1"
                                         Height="60"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Optionaler Zusatztext (der Zeitraum wird automatisch eingefügt).\nBeispiel: Ich antworte ggf. zeitverzögert."
                                         Margin="0,0,0,8"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="Von:" Width="40" VerticalAlignment="Center"/>
                                    <DatePicker x:Name="VacationStartDate" Width="120"/>
                                    <TextBlock Text="Bis:" Width="40" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <DatePicker x:Name="VacationEndDate" Width="120"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Hinweis" Width="55" VerticalAlignment="Center"/>
                                    <TextBox x:Name="VacationNoticeDays"
                                             Width="50"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Wie viele Tage vor Urlaubsbeginn soll der Hinweis in der Signatur erscheinen? (1–365)"/>
                                    <TextBlock Text="Tage vorher" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Signatur (Step 10.6 - Strukturierte Felder) -->
            <TabItem Header="Signatur">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="10">

                        <TextBlock Text="Firmensignatur (strukturiert)"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <!-- Persönlich -->
                        <GroupBox Header="Persönlich" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Grußformel:" VerticalAlignment="Center"/>
                                <TextBox x:Name="GreetingText" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Hashtag:" Grid.Row="1" VerticalAlignment="Center"/>
                                <TextBox x:Name="HashtagText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Präfix:" Grid.Row="2" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PrefixCombo" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5">
                                    <ComboBoxItem Content="i. V." IsSelected="True"/>
                                    <ComboBoxItem Content="i. A."/>
                                    <ComboBoxItem Content="ppa"/>
                                    <ComboBoxItem Content="(kein Präfix)"/>
                                </ComboBox>

                                <TextBlock Text="Name:" Grid.Row="3" VerticalAlignment="Center"/>
                                <TextBox x:Name="NameText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Rolle:" Grid.Row="4" VerticalAlignment="Center"/>
                                <TextBox x:Name="RoleText" Grid.Row="4" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <!-- Skyline -->
                        <GroupBox Header="Skyline" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="SkylineEnabled" Content="Skyline anzeigen"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Firma -->
                        <GroupBox Header="Firma" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Firmenname:" VerticalAlignment="Center"/>
                                <TextBox x:Name="CompanyText" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Niederlassung:" Grid.Row="1" VerticalAlignment="Center"/>
                                <TextBox x:Name="BranchText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Straße:" Grid.Row="2" VerticalAlignment="Center"/>
                                <TextBox x:Name="StreetText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="PLZ / Ort:" Grid.Row="3" VerticalAlignment="Center"/>
                                <TextBox x:Name="ZipCityText" Grid.Row="3" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <!-- Kontakt -->
                        <GroupBox Header="Kontakt" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Telefon:" VerticalAlignment="Center"/>
                                <TextBox x:Name="PhoneText" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Mobil:" Grid.Row="1" VerticalAlignment="Center"/>
                                <TextBox x:Name="MobileText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="E-Mail:" Grid.Row="2" VerticalAlignment="Center"/>
                                <TextBox x:Name="EmailText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Website:" Grid.Row="3" VerticalAlignment="Center"/>
                                <TextBox x:Name="WebsiteText" Grid.Row="3" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <!-- Rechtliches -->
                        <GroupBox Header="Rechtliches" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Sitz Gesellschaft:" VerticalAlignment="Center"/>
                                <TextBox x:Name="JurisdictionText" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Geschäftsführer:" Grid.Row="1" VerticalAlignment="Center"/>
                                <TextBox x:Name="DirectorsText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Registergericht:" Grid.Row="2" VerticalAlignment="Center"/>
                                <TextBox x:Name="RegisterText" Grid.Row="2" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <!-- Social Media -->
                        <GroupBox Header="Social Media (optional)" Margin="0,0,0,10">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="LinkedIn:" VerticalAlignment="Center"/>
                                <TextBox x:Name="LinkedInUrl" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Twitter:" Grid.Row="1" VerticalAlignment="Center"/>
                                <TextBox x:Name="TwitterUrl" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Facebook:" Grid.Row="2" VerticalAlignment="Center"/>
                                <TextBox x:Name="FacebookUrl" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Xing:" Grid.Row="3" VerticalAlignment="Center"/>
                                <TextBox x:Name="XingUrl" Grid.Row="3" Grid.Column="1"/>
                            </Grid>
                        </GroupBox>

                        <!-- Optionen -->
                        <GroupBox Header="Optionen" Margin="0,0,0,10">
                            <StackPanel Margin="10">
                                <CheckBox x:Name="EnvHintCheck" Content="Umwelt-Hinweis anzeigen"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Vorschau (Step 10.8) -->
                        <GroupBox Header="Vorschau" Margin="0,0,0,10">
                            <Grid>
                                <WebBrowser x:Name="SignaturePreviewBrowser"
                                            Height="400"/>
                            </Grid>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern"
                Width="120"
                Margin="5"
                Click="Save_Click"/>
            <Button Content="Schließen"
                    Width="100"
                    Margin="5"
                    Click="Close_Click"/>
        </StackPanel>

    </Grid>
</Window>
